{
  "name": "dsh-boot-animation",
  "version": "0.2.4",
  "description": "打开软件时铺满窗口播放一段片头开机动画，播完淡出进入工作区。A full-frame boot animation plays as the application opens, then fades into the workspace.",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "license": "BSD-3-Clause",
  "author": "NativeDog1",
  "contributors": [
    "Sprout-0"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sprout-0/dsh-boot-animation.git"
  },
  "homepage": "https://github.com/Sprout-0/dsh-boot-animation#readme",
  "bugs": {
    "url": "https://github.com/Sprout-0/dsh-boot-animation/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "boot-animation",
    "intro",
    "splash",
    "startup"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:client": "node scripts/check-css-template.mjs && tsdown",
    "embed-clips": "node scripts/embed-clips.mjs",
    "check": "node scripts/check-css-template.mjs && node scripts/verify.mjs",
    "verify:browser": "node scripts/verify-boot-browser.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    }
  }
}
